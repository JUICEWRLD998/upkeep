{
  "name": "upkeep",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --exclude tests/live.*",
    "test:live": "vitest run tests/live.keys.test.ts tests/live.db.test.ts tests/live.desk.test.ts",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "e2e": "node scripts/e2e-two-browsers.mjs",
    "e2e:desk": "node scripts/e2e-desk.mjs",
    "verify:ui": "node scripts/verify-ui.mjs",
    "stress:ui": "node scripts/stress-ui.mjs",
    "vitals:ui": "node scripts/vitals-ui.mjs",
    "filmstrip": "node scripts/filmstrip.mjs",
    "palette": "node scripts/measure-palette.mjs",
    "e2e:hardening": "node scripts/e2e-hardening.mjs",
    "abuse": "node scripts/abuse-api.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "motion": "^14.1.0",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "viem": "2.57.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "^4.14.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.4.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}


